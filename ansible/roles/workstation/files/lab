#!/usr/bin/python3
"""Dispatcher REMOTO de labs, instalado na workstation.

Resolve o host responsável pelo exercício em catalog.json e delega a
/usr/local/bin/lab-remote no(s) host(s) de destino: via SSH para
servera/serverb, ou invocação local (sem SSH) quando o próprio alvo é a
workstation (exercícios como shell-scripting-01, que o role lab_common
também instala aqui). Alvo remoto inacessível -> código de saída 2, nunca
cai para execução local nesse caso -- a distinção é "alvo declarado é este
host" (correto, sem SSH) vs "alvo declarado é outro host e não deu para
alcançar" (erro, nunca faz o trabalho aqui em substituição).

Registra cada execução no banco do dashboard (mesma lógica de
backend.ProgressStore usada pelo painel web) -- aqui embutido diretamente no
dispatcher, e não como um wrapper transparente em volta de outro binário,
porque (diferente do ambiente original) não existe nenhum dispatcher externo
proprietário a preservar: este é o único `lab` deste ambiente.
"""
import subprocess
import sys
import time

sys.path.insert(0, '/opt/rhcsa-lab-dashboard')
from backend import ProgressStore, load_catalog  # noqa: E402

CATALOG_PATH = '/opt/rhcsa-lab-dashboard/catalog.json'
DATA_DIR = '/var/lib/rhcsa-lab-dashboard'
ACTIONS = ('start', 'grade', 'finish')
SSH_TIMEOUT_S = 600


def usage():
    print('uso: lab <start|grade|finish> <id>', file=sys.stderr)
    print('     lab list', file=sys.stderr)
    return 2


def cmd_list(catalog):
    for task in sorted(catalog, key=lambda t: t['number']):
        hosts = ','.join(task['hosts'])
        print(f"{task['number']:>2}  {task['id']:<28} {hosts:<20} {task['title']}")
    return 0


def local_short_hostname():
    try:
        return subprocess.run(
            ['hostname', '-s'], stdout=subprocess.PIPE, check=True,
        ).stdout.decode().strip()
    except (subprocess.CalledProcessError, OSError):
        return ''


def run_on_host(host, action, task_id):
    print(f'==> lab {action} {task_id} ({host})', flush=True)
    remote_cmd = ['sudo', '/usr/local/bin/lab-remote', action, task_id]
    is_local = host == local_short_hostname()
    cmd = remote_cmd if is_local else [
        'ssh', '-o', 'BatchMode=yes', '-o', 'ConnectTimeout=5', host, *remote_cmd]
    try:
        proc = subprocess.run(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
            timeout=SSH_TIMEOUT_S, check=False)
    except (subprocess.TimeoutExpired, OSError) as exc:
        alvo = 'localmente' if is_local else f'em {host} via SSH'
        print(f'lab: falha ao executar {alvo}: {exc}', file=sys.stderr)
        return None
    chunk = proc.stdout.decode('utf-8', 'replace')
    sys.stdout.write(chunk)
    sys.stdout.flush()
    return chunk, proc.returncode


def main(argv):
    catalog = load_catalog(CATALOG_PATH)

    if argv == ['list']:
        return cmd_list(catalog)

    if len(argv) != 2 or argv[0] not in ACTIONS:
        return usage()

    action, task_id = argv
    tasks = {t['id']: t for t in catalog}
    if task_id not in tasks:
        print(f"lab: '{task_id}' não encontrado. Use 'lab list'.", file=sys.stderr)
        return 2

    task = tasks[task_id]
    started_ns = time.time_ns()
    output_parts = []
    returncode = 0

    # Em labs multi-host, 'hosts' está na ordem de resolução (ex.: servidor
    # antes de cliente, para start/grade). No finish, a ordem certa é a
    # inversa (cliente desmonta antes do servidor remover o export) -- já
    # foi bug real em produção quando essa regra ficou só documentada em
    # texto em vez de virar código.
    order = list(reversed(task['hosts'])) if action == 'finish' else task['hosts']

    for host in order:
        result = run_on_host(host, action, task_id)
        if result is None:
            # Alvo inacessível: falha explícita, nunca execução local.
            return 2
        chunk, host_returncode = result
        output_parts.append(chunk)
        if host_returncode != 0:
            returncode = host_returncode

    output = '\n'.join(output_parts)
    try:
        ProgressStore(DATA_DIR, catalog).record(
            task_id, action, output, returncode, started_ns=started_ns)
    except Exception as exc:  # observacional: nunca deve mudar o resultado do lab
        print(f'AVISO: dashboard não registrou este evento ({type(exc).__name__}).',
              file=sys.stderr)

    return returncode


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
