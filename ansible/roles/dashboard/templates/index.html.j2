<style>
:root{--bg:#131516;--panel:#1b1e20;--raised:#24282b;--border:#373c40;--ink:#f0f0ed;--muted:#b1b6ba;--quiet:#90979d;--accent:#ee7777;--green:#91d2a6;--amber:#f0c273;--red:#ff9393;--mono:Consolas,"Liberation Mono",monospace}
*{box-sizing:border-box}html{scrollbar-gutter:stable}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 Arial,Helvetica,sans-serif}button,input,select{font:inherit}button,input,select{color:inherit}button{cursor:pointer;border:1px solid var(--border);background:var(--raised);border-radius:5px;padding:10px 14px;min-height:44px;font-weight:600}button:hover{background:#303538;border-color:#737a80}button:disabled{opacity:.5;cursor:default}a{color:var(--ink);text-underline-offset:4px}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible,pre:focus-visible{outline:2px solid var(--accent);outline-offset:4px}[hidden]{display:none!important}.skip{position:absolute;top:-80px;left:16px;z-index:10;background:var(--ink);color:var(--bg);padding:12px}.skip:focus{top:12px}.topbar{padding:22px 30px 19px;display:flex;align-items:center;justify-content:space-between;gap:20px;border-bottom:1px solid var(--border)}.identity{display:flex;align-items:center;gap:14px}.mark{display:grid;place-items:center;width:35px;height:35px;border:1px solid #734747;color:var(--accent);font:700 17px var(--mono);border-radius:4px}h1{font-size:20px;letter-spacing:-.5px;line-height:1.3;margin:0}p{margin:0}h2,h3{line-height:1.3;margin:0}.subtitle{font-size:13px;color:var(--muted);margin-top:4px}.connection{text-align:right;font-size:12px;color:var(--muted)}.connection-state{font-size:13px;color:var(--ink);display:flex;align-items:center;justify-content:flex-end;gap:8px;margin-bottom:3px}.dot{height:7px;width:7px;background:var(--quiet);border-radius:50%;display:inline-block}.dot.online{background:var(--green)}.dot.offline{background:var(--amber)}.banner{background:#30271b;color:#f7d5a0;border-bottom:1px solid #655336;padding:13px 30px;font-size:14px}.layout{display:grid;grid-template-columns:298px minmax(0,1fr);max-width:1600px;margin:0 auto;min-height:calc(100vh - 96px)}.sidebar{border-right:1px solid var(--border);padding:23px 17px 28px;background:#17191b}.sidebar-title{display:flex;align-items:center;justify-content:space-between;padding:0 10px;margin-bottom:14px}.eyebrow{font-size:11px;font-weight:700;letter-spacing:1.4px;text-transform:uppercase;color:var(--muted)}.counter{font:12px var(--mono);color:var(--muted)}.search{display:block;width:100%;background:var(--bg);border:1px solid var(--border);border-radius:5px;padding:11px 12px;min-height:44px}.task-list{display:flex;flex-direction:column;gap:4px;margin-top:14px}.task-row{width:100%;display:grid;grid-template-columns:27px minmax(0,1fr) 12px;gap:10px;text-align:left;align-items:center;background:transparent;border-color:transparent;padding:10px;min-height:63px;font-weight:400}.task-row[aria-current="true"]{background:#292b2d;border-color:#56504e}.task-number{font:13px var(--mono);color:var(--muted)}.task-row[aria-current="true"] .task-number{color:var(--accent)}.row-title{display:block;font-size:13px;font-weight:600;line-height:1.35;overflow-wrap:anywhere}.row-status{display:block;font-size:11px;margin-top:4px;color:var(--muted)}.row-indicator{font-size:14px;color:var(--quiet)}.task-row[data-status="passed"] .row-indicator{color:var(--green)}.task-row[data-status="failed"] .row-indicator{color:var(--amber)}.task-row[data-status="error"] .row-indicator{color:var(--red)}.source-note{font-size:12px;color:var(--quiet);border-top:1px solid var(--border);margin:20px 10px 0;padding-top:16px}.mobile-picker{display:none}main{padding:27px 36px 24px;min-width:0}.progress-head{display:flex;gap:16px;justify-content:space-between;font-size:13px;color:var(--muted);margin-bottom:10px}.progress-head strong{color:var(--ink);font-weight:600}.progress-track{height:4px;background:var(--border);border-radius:2px;overflow:hidden}.progress-fill{height:100%;width:0;background:var(--green);transition:width .2s}.summary-counts{font-size:12px;color:var(--quiet);margin-top:9px;min-height:19px}.task-heading{margin:27px 0 21px;display:flex;justify-content:space-between;gap:20px;align-items:flex-start}.task-heading h2{font-size:clamp(23px,2.1vw,31px);letter-spacing:-.7px;margin-top:7px;overflow-wrap:anywhere}.task-meta{display:flex;gap:9px;flex-wrap:wrap;margin-top:12px;font-size:12px;color:var(--muted)}.host{font:12px var(--mono);padding:3px 7px;border:1px solid var(--border);border-radius:3px}.status{white-space:nowrap;border:1px solid var(--border);border-radius:4px;background:var(--panel);font-size:12px;padding:6px 10px;display:inline-block}.task-aside{display:grid;justify-items:end;gap:9px;flex:0 0 auto}.stopwatch{min-width:151px;border:1px solid var(--border);border-radius:5px;background:#171a1b;padding:8px 10px;text-align:right;line-height:1.2}.stopwatch-label{display:block;color:var(--muted);font-size:10px;letter-spacing:.08em;text-transform:uppercase}.stopwatch-value{display:block;font:700 21px/1.2 var(--mono);font-variant-numeric:tabular-nums;letter-spacing:-.5px;margin:3px 0}.stopwatch-state{display:block;color:var(--quiet);font-size:11px}.stopwatch[data-state="running"]{border-color:#6b5531}.stopwatch[data-state="running"] .stopwatch-value{color:var(--amber)}.stopwatch[data-state="finished"] .stopwatch-value{color:var(--green)}.status[data-status="passed"]{color:var(--green);border-color:#395b43;background:#1c2a20}.status[data-status="failed"]{color:var(--amber);border-color:#6b5531;background:#2d261b}.status[data-status="error"]{color:var(--red);border-color:#734545;background:#312020}.status[data-status="in_progress"]{color:#deded9;border-color:#6d7274}.work-area{display:grid;grid-template-columns:minmax(0,1fr) 286px;gap:22px;align-items:start}.section{border:1px solid var(--border);border-radius:6px;background:var(--panel);min-width:0}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:16px 19px;border-bottom:1px solid var(--border)}.section h3{font-size:14px}.section-body{padding:18px 19px}.description{white-space:pre-wrap;overflow-wrap:anywhere;color:#e2e4e4;font-size:14px}.instructions{padding-left:20px;margin:15px 0 0;font-size:14px;color:#d2d6d8}.instructions li{padding:4px 0 4px 3px;white-space:pre-wrap;overflow-wrap:anywhere}.warning{margin-top:18px;border:1px solid #6a5634;border-radius:4px;background:#2c261d;color:#f0d1a0;padding:12px 13px;font-size:13px;white-space:pre-wrap;overflow-wrap:anywhere}.warning strong{display:block;margin-bottom:3px}.terminal-guide .section-body{padding:16px}.terminal-guide h3{font-size:13px}.muted{color:var(--muted)}.small{font-size:12px}.command{margin-top:15px}.command-label{font-size:11px;color:var(--muted);display:flex;justify-content:space-between;gap:8px;margin-bottom:6px}.command-line{display:flex;align-items:center;border:1px solid var(--border);border-radius:4px;background:var(--bg);min-width:0}.command-line code{font:12px/1.7 var(--mono);padding:10px;overflow-wrap:anywhere;min-width:0;flex:1;user-select:all}.copy{padding:0 10px;align-self:stretch;min-width:44px;min-height:44px;border:0;border-left:1px solid var(--border);background:transparent;font-size:11px;border-radius:0}.execution-target{display:flex;align-items:center;justify-content:space-between;gap:22px;border:1px solid #5a4b35;background:#211e19;border-radius:6px;padding:15px 18px;margin:18px 0 22px}.execution-target .eyebrow{margin-bottom:4px;color:var(--amber)}.execution-target strong{font-size:16px}.execution-target-note{font-size:12px;color:var(--muted);margin-top:5px;max-width:760px}.target-command{width:min(310px,100%);flex:0 0 auto}.target-command .command-label{margin-bottom:5px}.manual-note{font-size:11px;color:var(--quiet);margin-top:16px}.result-section{margin-top:22px}.result-subtitle{font-size:12px;color:var(--muted);margin-top:4px}.criteria{list-style:none;padding:0;margin:0}.criterion{display:flex;gap:10px;padding:10px 0;font-size:13px;border-bottom:1px solid #303538;overflow-wrap:anywhere}.criterion:last-child{border:0}.criterion-icon{font-weight:bold;color:var(--amber);flex-shrink:0}.criterion[data-ok="true"] .criterion-icon{color:var(--green)}.empty-note{font-size:13px;color:var(--muted);padding:4px 0}.output-label{padding:11px 19px;border-top:1px solid var(--border);background:#17191b;display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:11px}.output{font:12px/1.8 var(--mono);margin:0;background:#101213;padding:16px 19px;max-height:420px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;tab-size:4;border-radius:0 0 6px 6px;color:#d5dada}.result-footnote{font-size:12px;color:var(--quiet);margin:10px 0 0}.next-row{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:22px 0}.next-row p{font-size:12px;color:var(--muted)}.next{background:#eaded9;color:#231b18;border-color:#eaded9;font-size:13px;white-space:nowrap}.next:hover{background:#fff0e9;border-color:#fff0e9}.history{border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:15px 0}.history summary{font-size:13px;cursor:pointer;min-height:30px;padding:4px 0}.history-list{list-style:none;margin:12px 0 0;padding:0}.history-item{display:flex;gap:12px;justify-content:space-between;border-top:1px solid var(--border);padding:12px 0;font-size:12px;flex-wrap:wrap}.history-item code{font-family:var(--mono)}.history-item time{color:var(--muted)}.duration-history{margin-top:18px}.duration-history-head{display:flex;justify-content:space-between;gap:12px;align-items:baseline}.duration-history-head h3{margin:0;font-size:14px}.duration-history-list{list-style:none;margin:10px 0 0;padding:0;border-top:1px solid var(--border)}.duration-history-item{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--border);font-size:12px;align-items:baseline}.duration-history-main{font:700 14px var(--mono);color:var(--ink);font-variant-numeric:tabular-nums}.duration-history-item time{color:var(--muted);white-space:nowrap}footer{margin-top:25px;font-size:11px;color:var(--quiet);display:flex;justify-content:space-between;gap:14px;flex-wrap:wrap}footer a{color:var(--muted)}.loading{border:1px dashed var(--border);padding:35px;margin:26px 0;color:var(--muted);border-radius:6px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.manual-copy{padding:13px 18px;background:var(--panel);border:1px solid var(--border);margin-top:15px;border-radius:5px}.manual-copy input{width:100%;padding:10px;background:var(--bg);border:1px solid var(--border);font:13px var(--mono);margin:8px 0}.manual-copy-head{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:13px}
@media(max-width:1180px){main{padding:25px}.layout{grid-template-columns:265px minmax(0,1fr)}.work-area{grid-template-columns:minmax(0,1fr)}.terminal-guide .section-body{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.terminal-guide .section-body>p,.terminal-guide .ssh-command,.terminal-guide .manual-note{grid-column:1/-1}.command{margin-top:0}.task-heading{gap:12px}}
@media(max-width:720px){.execution-target{align-items:stretch;flex-direction:column;gap:14px}.target-command{width:100%}.topbar{padding:18px;align-items:flex-start}.identity{gap:10px}.mark{display:none}h1{font-size:18px}.connection{max-width:135px;font-size:10px}.connection-state{font-size:11px}.layout{display:block}.sidebar{padding:14px 18px;border-right:0;border-bottom:1px solid var(--border)}.sidebar-title,.search,.task-list,.sidebar .source-note{display:none}.mobile-picker{display:block}.mobile-picker label{display:block;font-size:11px;color:var(--muted);margin-bottom:6px}.mobile-picker select{display:block;width:100%;max-width:100%;background:var(--panel);border:1px solid var(--border);border-radius:5px;padding:10px;min-height:44px}main{padding:21px 18px}.task-heading{flex-direction:column;margin-top:24px}.task-heading h2{font-size:25px}.task-aside{order:-1;width:100%;display:flex;justify-content:space-between;align-items:flex-start;gap:12px}.stopwatch{min-width:145px}.work-area{gap:16px}.section-head,.section-body{padding:16px}.terminal-guide .section-body{grid-template-columns:minmax(0,1fr);gap:15px}.terminal-guide .section-body>*{grid-column:1!important}.progress-head{font-size:12px;gap:8px}.next-row{align-items:flex-start;flex-direction:column;gap:12px}.next{width:100%}.banner{padding:12px 18px;font-size:13px}.output{padding:15px;font-size:11px}.output-label{padding:10px 16px}.history-item{flex-direction:column;gap:4px}.duration-history-item{align-items:flex-start;flex-direction:column;gap:4px}.duration-history-item time{white-space:normal}footer{font-size:11px}.subtitle{font-size:11px}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
