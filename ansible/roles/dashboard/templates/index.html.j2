}
if (typeof module !== 'undefined') module.exports={validateState,createDashboard,attemptStopwatch,completedAttempts,formatDuration};
if (typeof document !== 'undefined') {
  const storage={getItem:key=>window.localStorage.getItem(key),setItem:(key,value)=>window.localStorage.setItem(key,value)};
  const dashboard=createDashboard(document,{storage,navigator:window.navigator,fetch:window.fetch.bind(window),AbortController:window.AbortController,now:()=>new Date()});
  dashboard.start();
  window.addEventListener('pagehide',()=>dashboard.stop());
  window.addEventListener('pageshow',()=>dashboard.start());
}
</script>
