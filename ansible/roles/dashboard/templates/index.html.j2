    text('summary-counts',`${summary.pending} pendentes · ${summary.in_progress} em andamento · ${summary.failed} para revisar · ${summary.error} com erro`);
    text('task-count',`${total} tarefas`);text('updated-at',`Estado atualizado: ${date(data.updated_at)}`);
