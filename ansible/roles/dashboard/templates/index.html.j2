    $('no-matches').hidden=!data?.tasks.length || visible>0;
  }
  function render() {
    const summary=data.summary, total=summary.total, percent=total?Math.round(summary.passed/total*100):0;
    text('progress-text',`${summary.passed} ${summary.passed===1?'tarefa aprovada':'tarefas aprovadas'}`);
    text('progress-fraction',`${summary.passed} / ${total} tarefas`);
