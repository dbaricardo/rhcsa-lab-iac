  const date = value => { if(!value)return 'sem registro';const d=new Date(value);return Number.isNaN(d.getTime())?'data não informada':d.toLocaleString('pt-BR',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit',second:'2-digit'}); };
