<body>
<a class="skip" href="#main">Ir para a tarefa</a>
<header class="topbar">
  <div class="identity"><span class="mark" aria-hidden="true">r_</span><div><h1>RHCSA · Laboratório</h1><p class="subtitle">Exercícios originais · rhcsa-lab-iac</p></div></div>
  <div class="connection"><div class="connection-state"><span id="connection-dot" class="dot" aria-hidden="true"></span><span id="connection-label">Conectando…</span></div><p id="last-fetched">Consulta automática a cada 2 s</p></div>
</header>
<div id="connection-error" class="banner" hidden></div>
<div id="announcer" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
<div class="layout">
<aside class="sidebar" aria-label="Navegação das tarefas">
  <div class="sidebar-title"><h2 class="eyebrow">Roteiro de tarefas</h2><span id="task-count" class="counter">—</span></div>
  <label class="sr-only" for="search">Buscar tarefa por título, número ou host</label><input id="search" class="search" type="search" placeholder="Buscar tarefa…" autocomplete="off">
  <nav id="task-list" class="task-list" aria-label="Tarefas na ordem do vídeo"></nav>
  <p id="no-matches" class="empty-note" hidden>Nenhuma tarefa encontrada.</p>
  <div class="mobile-picker"><label for="task-select">TAREFAS · ORDEM DO VÍDEO</label><select id="task-select" disabled><option>Aguardando tarefas…</option></select></div>
  <p class="source-note">Numeração dos exercícios originais deste repositório (labs/).<br>Novos exercícios podem ser adicionados — ver docs/exercises-authoring-guide.md.</p>
</aside>
<main id="main" tabindex="-1">
  <section aria-label="Progresso do laboratório"><div class="progress-head"><strong id="progress-text">Aguardando avaliações</strong><span id="progress-fraction">— / — tarefas</span></div><div id="progress" class="progress-track" role="progressbar" aria-label="Tarefas aprovadas" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><div id="progress-fill" class="progress-fill"></div></div><p id="summary-counts" class="summary-counts">Os resultados aparecem após executar lab grade.</p></section>
  <div id="empty-state" class="loading">Carregando o estado do laboratório…</div>
  <article id="task-detail" hidden aria-labelledby="task-title">
    <div class="task-heading"><div><p id="task-number" class="eyebrow">Tarefa</p><h2 id="task-title"></h2><div class="task-meta"><span id="task-hosts" class="host"></span><span id="task-id"></span></div></div><div class="task-aside"><span id="task-status" class="status">Ainda não avaliada</span><div id="stopwatch" class="stopwatch" data-state="waiting" role="timer" aria-live="off" aria-label="Tempo da tentativa: aguardando lab start"><span class="stopwatch-label">Tempo da tentativa</span><strong id="stopwatch-value" class="stopwatch-value">00:00:00</strong><span id="stopwatch-state" class="stopwatch-state">Aguardando lab start</span></div></div></div>
    <section class="execution-target" aria-labelledby="solve-heading"><div><p id="solve-heading" class="eyebrow">Executar a solução em</p><strong id="solve-target"></strong><p id="solve-note" class="execution-target-note"></p></div><div id="solve-command-wrap" class="target-command"><div class="command-label"><span>Acessar a VM da tarefa</span></div><div class="command-line"><code id="solve-command"></code><button class="copy" type="button" data-copy="solve-command" aria-label="Copiar comando para acessar a VM da tarefa">Copiar</button></div></div></section>
    <div class="work-area">
      <section class="section"><div class="section-head"><h3>Enunciado</h3><span class="eyebrow">Objetivo</span></div><div class="section-body"><p id="description" class="description"></p><ol id="instructions" class="instructions"></ol><div id="warning" class="warning" hidden><strong>Atenção neste ambiente</strong><span id="warning-text"></span></div></div></section>
      <section class="section terminal-guide" aria-labelledby="commands-heading"><div class="section-head"><h3 id="commands-heading">Controle do lab · sempre na workstation</h3></div><div class="section-body"><p class="small muted">Entre na workstation e execute nela todos os comandos deste bloco.</p><div class="command ssh-command"><div class="command-label"><span>Entrar na workstation</span></div><div class="command-line"><code id="ssh-command">ssh {{ lab_student_user }}@{{ workstation_ip }}</code><button class="copy" type="button" data-copy="ssh-command" aria-label="Copiar comando SSH da workstation">Copiar</button></div></div><div class="command"><div class="command-label"><span>01 · Preparar</span></div><div class="command-line"><code id="start-command"></code><button class="copy" type="button" data-copy="start-command" aria-label="Copiar comando lab start">Copiar</button></div></div><div class="command"><div class="command-label"><span>02 · Avaliar</span></div><div class="command-line"><code id="grade-command"></code><button class="copy" type="button" data-copy="grade-command" aria-label="Copiar comando lab grade">Copiar</button></div></div><div class="command"><div class="command-label"><span>03 · Encerrar</span></div><div class="command-line"><code id="finish-command"></code><button class="copy" type="button" data-copy="finish-command" aria-label="Copiar comando lab finish">Copiar</button></div></div><p class="manual-note">Este painel só monitora. Nenhum comando é executado pelo navegador.</p></div></section>
    </div>
    <div id="manual-copy" class="manual-copy" hidden><div class="manual-copy-head"><label for="manual-copy-input">Cópia manual · selecione e copie o comando</label><button id="close-copy" type="button">Fechar</button></div><input id="manual-copy-input" readonly><p class="small muted">Use Ctrl+C ou toque e segure para copiar.</p></div>
    <section class="section result-section" aria-labelledby="result-heading"><div class="section-head"><div><h3 id="result-heading">Resultado da avaliação</h3><p id="grade-time" class="result-subtitle">Ainda não avaliada</p></div><span id="criteria-count" class="counter">—</span></div><div class="section-body"><ul id="criteria" class="criteria"></ul><p id="criteria-empty" class="empty-note">Ainda não avaliada</p></div><div class="output-label"><span>SAÍDA DO LAB · ÚLTIMO REGISTRO</span><span id="attempts">Sem tentativas</span></div><pre id="output" class="output" tabindex="0" aria-label="Saída registrada do laboratório">Nenhuma saída registrada.</pre></section>
    <p class="result-footnote">O grade avalia esta etapa do laboratório, não a pontuação total do conteúdo RHCSA.</p>
    <div class="next-row"><p id="last-event">Último evento: nenhum registro.</p><button id="next-task" type="button" class="next" disabled>Próxima pendente <span aria-hidden="true">→</span></button></div>
    <section id="duration-history" class="duration-history" aria-labelledby="duration-history-title" hidden><div class="duration-history-head"><h3 id="duration-history-title">Tempos concluídos</h3><span id="duration-history-count" class="counter"></span></div><ol id="duration-history-list" class="duration-history-list"></ol></section>
    <details id="history" class="history"><summary id="history-title">Histórico salvo · sem eventos</summary><ol id="history-list" class="history-list"></ol></details>
  </article>
  <footer><p>rhcsa-lab-iac · exercícios originais, não afiliados à Red Hat.<br>Não inclui o material licenciado RH199 — ver NOTICE.md.</p><p><span id="updated-at">Estado atualizado: sem registro</span></p></footer>
</main>
</div>
<script id="app">
'use strict';
const STATUS = Object.freeze({pending:'Ainda não avaliada',in_progress:'Em andamento',passed:'Aprovada',failed:'Revisar critérios',error:'Erro de infraestrutura'});
function formatDuration(value) {
  const seconds=Math.floor(Math.max(0,Number(value)||0)/1000), hours=Math.floor(seconds/3600), minutes=Math.floor(seconds%3600/60), rest=seconds%60;
  return [hours,minutes,rest].map((part,index)=>index===0?String(part).padStart(2,'0'):String(part).padStart(2,'0')).join(':');
}
function attemptStopwatch(history, now) {
  const toMs=value=>{const ms=Date.parse(value);return Number.isFinite(ms)?ms:null;};
  const nowMs=toMs(now)||Date.now();let startedAt=null,startedMs=null,endedAt=null,endedMs=null;
  for(const event of [...history].sort((a,b)=>(toMs(a.at)||0)-(toMs(b.at)||0))){
    const atMs=toMs(event.at);if(atMs===null)continue;
    if(event.action==='start' && event.returncode===0){startedAt=event.at;startedMs=atMs;endedAt=null;endedMs=null;}
    else if(startedMs!==null && event.action==='finish'){endedAt=event.at;endedMs=atMs;}
  }
  if(startedMs===null)return {state:'waiting',elapsedMs:0,startedAt:null,endedAt:null};
  if(endedMs!==null)return {state:'finished',elapsedMs:Math.max(0,endedMs-startedMs),startedAt,endedAt};
  return {state:'running',elapsedMs:Math.max(0,nowMs-startedMs),startedAt,endedAt:null};
}
function completedAttempts(history) {
  const toMs=value=>{const ms=Date.parse(value);return Number.isFinite(ms)?ms:null;};
  const attempts=[];let current=null;
  for(const event of [...history].sort((a,b)=>(toMs(a.at)||0)-(toMs(b.at)||0))){
    const atMs=toMs(event.at);if(atMs===null)continue;
    if(event.action==='start' && event.returncode===0){current={startedAt:event.at,startedMs:atMs,status:null};}
    else if(current && event.action==='grade' && ['passed','failed','error'].includes(event.status)){current.status=event.status;}
    else if(current && event.action==='finish'){
      attempts.push({startedAt:current.startedAt,endedAt:event.at,elapsedMs:Math.max(0,atMs-current.startedMs),status:['passed','failed','error'].includes(event.status)?event.status:(current.status||'pending')});
      current=null;
    }
  }
  return attempts;
}
function validateState(value) {
  const bad = () => { throw new Error('Resposta inválida da API'); };
  const integer = n => Number.isInteger(n) && n >= 0;
  const nullableText = s => s === null || typeof s === 'string';
  const counts = x => integer(x.passed_criteria) && integer(x.total_criteria) && x.passed_criteria <= x.total_criteria;
  if (!value || !Array.isArray(value.tasks) || !value.summary || !nullableText(value.updated_at) || !nullableText(value.next_task)) bad();
  const ids = new Set();
  for (const t of value.tasks) {
    if (!t || typeof t.id !== 'string' || !/^[a-zA-Z0-9][a-zA-Z0-9_-]*$/.test(t.id) || ids.has(t.id) || !integer(t.number) || !Object.hasOwn(STATUS,t.status)) bad();
    ids.add(t.id);
    if (!['title','host','description','warning','output','solve_target','solve_command','solve_note'].every(k=>typeof t[k]==='string') || !['hosts','instructions'].every(k=>Array.isArray(t[k]) && t[k].every(s=>typeof s==='string'))) bad();
    if (!['ssh','console'].includes(t.solve_method) || (t.solve_method==='ssh' && !/^ssh (servera|serverb)$/.test(t.solve_command)) || (t.solve_method==='console' && t.solve_command!=='')) bad();
    if (!counts(t) || !integer(t.attempts) || !nullableText(t.last_grade_at) || !nullableText(t.last_action) || !Array.isArray(t.criteria) || !Array.isArray(t.history)) bad();
    if (!t.criteria.every(c=>c && typeof c.ok==='boolean' && typeof c.text==='string')) bad();
    if (!t.history.every(h=>h && typeof h.action==='string' && Object.hasOwn(STATUS,h.status) && nullableText(h.at) && (h.returncode===null || Number.isInteger(h.returncode)) && counts(h))) bad();
  }
  if (value.next_task !== null && !ids.has(value.next_task)) bad();
  if (!['total',...Object.keys(STATUS)].every(k=>integer(value.summary[k])) || value.summary.total!==value.tasks.length) bad();
  if (Object.keys(STATUS).reduce((n,k)=>n+value.summary[k],0)!==value.summary.total) bad();
  return value;
}
function createDashboard(doc, env) {
