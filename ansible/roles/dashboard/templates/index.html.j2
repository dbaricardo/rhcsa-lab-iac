  let rows=new Map(), options=new Map();
  function refreshStopwatch() {
    const task=data?.tasks.find(item=>item.id===selectedId);
    const timer=attemptStopwatch(task?.history||[],env.now?env.now():new Date());
    const state=timer.state==='running'?'Em andamento':timer.state==='finished'?'Encerrada':'Aguardando lab start';
    text('stopwatch-value',formatDuration(timer.elapsedMs));text('stopwatch-state',state);
    $('stopwatch').dataset.state=timer.state;
