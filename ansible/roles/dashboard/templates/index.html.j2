        if(!row){
          const button=node('button','task-row');button.type='button';
          const number=node('span','task-number'),body=node('span'),title=node('span','row-title'),status=node('span','row-status'),indicator=node('span','row-indicator');indicator.setAttribute('aria-hidden','true');
          body.append(title,status);button.append(number,body,indicator);button.addEventListener('click',()=>select(t.id));
          row={button,number,title,status,indicator};
        }
        nextRows.set(t.id,row);const option=options.get(t.id)||node('option');option.value=t.id;nextOptions.set(t.id,option);
      }
      rows=nextRows;options=nextOptions;$('task-list').replaceChildren(...Array.from(rows.values(),r=>r.button));$('task-select').replaceChildren(...options.values());listSignature=signature;
    }
    for(const t of data.tasks){
      const r=rows.get(t.id);r.number.textContent=String(t.number).padStart(2,'0');r.title.textContent=t.title;r.status.textContent=STATUS[t.status];r.indicator.textContent=t.status==='passed'?'✓':t.status==='error'?'!':t.status==='failed'?'!':t.status==='in_progress'?'◉':'·';r.button.dataset.status=t.status;r.button.setAttribute('aria-current',String(t.id===selectedId));
      const label=`${String(t.number).padStart(2,'0')} · ${t.title} · ${STATUS[t.status]}`;
      r.button.setAttribute('aria-label',label);if(options.get(t.id).textContent!==label)options.get(t.id).textContent=label;
    }
    $('task-select').disabled=!total;if($('task-select').value!==selectedId)$('task-select').value=selectedId||'';filter();
    const t=data.tasks.find(t=>t.id===selectedId);
    $('empty-state').hidden=Boolean(t);$('task-detail').hidden=!t;
    if(!t){text('empty-state','Nenhuma tarefa disponível no catálogo.');renderedTask=null;return;}
    const taskSnapshot=JSON.stringify(t);
    if(taskSnapshot!==renderedTask){
      text('task-number',`Tarefa ${String(t.number).padStart(2,'0')} · roteiro do vídeo`);text('task-title',t.title);text('task-id',t.id);text('task-hosts',`Hosts avaliados: ${t.hosts.length?t.hosts.join(' + '):t.host}`);
      text('solve-target',t.solve_target);text('solve-note',t.solve_note);text('solve-command',t.solve_command);$('solve-command-wrap').hidden=t.solve_method!=='ssh';
      text('task-status',STATUS[t.status]);$('task-status').dataset.status=t.status;text('description',t.description||'Enunciado não informado.');
      $('instructions').replaceChildren(...t.instructions.map(line=>node('li','',line)));$('instructions').hidden=!t.instructions.length;
      $('warning').hidden=!t.warning;text('warning-text',t.warning);
      for(const action of ['start','grade','finish'])text(`${action}-command`,`lab ${action} ${t.id}`);
      text('grade-time',t.last_grade_at?`Último grade · ${date(t.last_grade_at)}`:'Ainda não avaliada');
      text('criteria-count',t.total_criteria?`${t.passed_criteria} / ${t.total_criteria} critérios`:'—');
      $('criteria').replaceChildren(...t.criteria.map(c=>{const li=node('li','criterion');li.dataset.ok=String(c.ok);const icon=node('span','criterion-icon',c.ok?'✓':'!');icon.setAttribute('aria-label',c.ok?'Aprovado':'Não aprovado');li.append(icon,node('span','',c.text));return li;}));
      $('criteria-empty').hidden=Boolean(t.criteria.length);text('criteria-empty',t.last_grade_at?'Nenhum critério individual registrado.':'Ainda não avaliada');
      const output=$('output'),scroll=output.scrollTop;text('output',t.output||'Nenhuma saída registrada.');output.scrollTop=scroll;
      text('attempts',t.attempts?`${t.attempts} ${t.attempts===1?'tentativa':'tentativas'}`:'Sem tentativas');
      const events=[...t.history].sort((a,b)=>(Date.parse(b.at)||0)-(Date.parse(a.at)||0)),last=events[0];
      text('last-event',last?`Último evento: lab ${last.action} · ${date(last.at)}`:t.last_action?`Último evento: ${t.last_action}`:'Último evento: nenhum registro.');
      text('history-title',`Histórico salvo · ${events.length?`${events.length} ${events.length===1?'evento':'eventos'}`:'sem eventos'}`);
      $('history-list').replaceChildren(...events.map(h=>{const li=node('li','history-item'),main=node('span'),when=node('time','',date(h.at));main.append(node('code','',`lab ${h.action}`),node('span','',` · ${STATUS[h.status]} · ${h.passed_criteria}/${h.total_criteria} critérios · saída ${h.returncode===null?'não registrada':h.returncode}`));if(h.at)when.setAttribute('datetime',h.at);li.append(main,when);return li;}));
      const completed=[...completedAttempts(t.history)].reverse();
      $('duration-history').hidden=!completed.length;
      text('duration-history-count',`${completed.length} ${completed.length===1?'tentativa':'tentativas'}`);
      $('duration-history-list').replaceChildren(...completed.map(attempt=>{const li=node('li','duration-history-item'),main=node('span','duration-history-main',`${formatDuration(attempt.elapsedMs)} · ${STATUS[attempt.status]}`),when=node('time','',date(attempt.endedAt));when.setAttribute('datetime',attempt.endedAt);li.append(main,when);return li;}));
      const notice=`Tarefa ${t.number}: ${STATUS[t.status]}. ${t.passed_criteria} de ${t.total_criteria} critérios.`;
      if(notice!==lastAnnouncement){announce(notice);lastAnnouncement=notice;}
      renderedTask=taskSnapshot;
    }
    refreshStopwatch();
    $('next-task').disabled=!data.next_task || data.next_task===selectedId;
    $('next-task').setAttribute('title',data.next_task===selectedId?'Você já está na próxima tarefa pendente.':data.next_task?'Abrir a próxima pendente sem executar comandos.':'Nenhuma tarefa pendente.');
  }
  function applyState(value) {
    data=validateState(value);
    if(!data.tasks.some(t=>t.id===selectedId))selectedId=data.tasks.some(t=>t.id===saved)?saved:data.next_task||data.tasks[0]?.id||null;
    saved=null;render();return selectedId;
  }
  $('search').addEventListener('input',filter);$('task-select').addEventListener('change',event=>select(event.target.value));$('next-task').addEventListener('click',()=>{if(data?.next_task)select(data.next_task);});
  let busy=false, running=false, pollTimer=null, stopwatchTimer=null, requestController=null, connection=null;
  const later=(fn,delay)=>(env.setTimeout||setTimeout)(fn,delay);
  const cancel=id=>(env.clearTimeout||clearTimeout)(id);
  async function poll() {
    if(busy)return;busy=true;
    const Controller=env.AbortController;
    requestController=Controller?new Controller():null;
    const timeout=later(()=>requestController?.abort(),8000);
    try {
      const response=await env.fetch('/api/state',{method:'GET',cache:'no-store',headers:{Accept:'application/json'},...(requestController?{signal:requestController.signal}:{})});
      if(!response.ok)throw new Error(`HTTP ${response.status}`);
      applyState(await response.json());
      const fetched=env.now?env.now():new Date();
      text('last-fetched',`Última consulta: ${fetched.toLocaleTimeString('pt-BR')}`);text('connection-label','Monitorando');$('connection-dot').className='dot online';$('connection-error').hidden=true;
      if(connection===false)announce('Conexão restabelecida. Estado atualizado.');connection=true;
    } catch(error) {
      const invalid=error.message?.includes('inválida') || error.name==='SyntaxError';
      const reason=invalid?'Resposta inválida da API.':'Não foi possível consultar o laboratório.';
      const message=`${reason} ${data?'Dados exibidos podem estar desatualizados.':'Nenhum resultado carregado.'} Nova tentativa automática a cada 2 s.`;
      text('connection-label','Sem atualização');$('connection-dot').className='dot offline';text('connection-error',message);$('connection-error').hidden=false;
      if(!data)text('empty-state','Não foi possível carregar as tarefas. Aguardando conexão com o laboratório.');
      if(connection!==false)announce(message);connection=false;
    } finally {cancel(timeout);busy=false;requestController=null;}
  }
  async function tick(){await poll();if(running)pollTimer=later(tick,2000);}
  function tickStopwatch(){refreshStopwatch();if(running)stopwatchTimer=later(tickStopwatch,1000);}
  async function start(){if(running)return;running=true;tickStopwatch();await tick();}
  function stop(){running=false;if(pollTimer!==null)cancel(pollTimer);if(stopwatchTimer!==null)cancel(stopwatchTimer);requestController?.abort();}
  let copyOrigin=null;
  async function copyText(value) {
    copyOrigin=doc.activeElement;
