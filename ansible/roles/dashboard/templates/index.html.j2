      if(env.navigator?.clipboard?.writeText){await env.navigator.clipboard.writeText(value);announce('Comando copiado. Execute manualmente no terminal.');return 'clipboard';}
    } catch (_) { /* Plain HTTP and denied permissions use the fallback below. */ }
    const temporary=node('textarea');temporary.value=value;temporary.style.position='fixed';temporary.style.opacity='0';temporary.style.top='0';temporary.setAttribute('aria-label','Comando para copiar');doc.body.append(temporary);
    let copied=false;
    try {temporary.focus();temporary.select();copied=Boolean(doc.execCommand && doc.execCommand('copy'));} catch (_) {} finally {temporary.remove();copyOrigin?.focus({preventScroll:true});}
    if(copied){announce('Comando copiado. Execute manualmente no terminal.');return 'legacy';}
    $('manual-copy').hidden=false;$('manual-copy-input').value=value;$('manual-copy-input').focus({preventScroll:true});$('manual-copy-input').select();announce('Cópia automática indisponível. Use o campo de cópia manual.');return 'manual';
  }
  for(const button of doc.querySelectorAll('[data-copy]'))button.addEventListener('click',async()=>{
    const original=button.textContent,method=await copyText($(button.dataset.copy).textContent);
