# Copie para .env (nunca commitado, ver .gitignore) e preencha com seus dados.

# Caminho local absoluto da ISO oficial do RHEL 10 (DVD, x86_64) que você já
# baixou da sua conta Red Hat. Nunca é redistribuída por este repositório.
RHEL_ISO_PATH=/caminho/absoluto/para/rhel-10.0-x86_64-dvd.iso

# Subscription (Red Hat Developer Subscription for Individuals, gratuita).
# Preenchidas, `make deploy` registra cada VM sozinha, uma a uma, depois de
# clonada -- cada VM ganha identidade própria na Red Hat (o que nunca pode
# acontecer é registrar a imagem golden, ver docs/explanation/problemas-conhecidos.md).
# Gere org ID e activation key em:
# https://console.redhat.com/insights/connector/activation-keys
# Vazias: registre à mão (ver docs/how-to/resolver-problemas.md) ou use
# `make deploy-offline` para testar sem conta Red Hat.
RHSM_ORG_ID=
RHSM_ACTIVATION_KEY=

# Senha do usuário "student" criado em todas as VMs (uso apenas local/lab).
STUDENT_PASSWORD=troque-esta-senha

# true/false — roda "dnf -y update --security" no fim do kickstart.
# Desligado por padrão para builds mais rápidos e reprodutíveis.
APPLY_SECURITY_UPDATES=false

# Senha de root das 3 VMs (login de console, como no homelab). Vazia = root
# fica travado e entra só por chave SSH. Nunca vai para o repositório; o
# dashboard só a usa para mascará-la nas saídas.
LAB_ROOT_PASSWORD=

# Mirror OSTree "myrepo" (flatpak.lab.example.com) montado a partir do
# Flathub no provisionamento: ~1,6 GB, exige internet. false = examsim-flatpak
# e dyn-flatpak-* não funcionam.
FLATPAK_MIRROR_ENABLED=true

# Gravação dos terminais (script do util-linux) em servera/serverb/workstation,
# em /var/log/rhcsa-rec (retenção de 14 dias). Pré-requisito da revisão por IA.
RHCSA_RECORDING_ENABLED=false

# Revisão por IA no `lab finish` (opcional, desligada). Exige a gravação
# ligada e um revisor acessível por SSH (ver contrib/ai-reviewer/README.md).
AI_REVIEW_ENABLED=false
AI_REVIEWER=
AI_REVIEW_TIMEOUT=780
