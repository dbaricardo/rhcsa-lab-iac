# Copie para .env (nunca commitado, ver .gitignore) e preencha com seus dados.

# Caminho local absoluto da ISO oficial do RHEL 10 (DVD, x86_64) que você já
# baixou da sua conta Red Hat. Nunca é redistribuída por este repositório.
RHEL_ISO_PATH=/caminho/absoluto/para/rhel-10.0-x86_64-dvd.iso

# Red Hat Developer Subscription for Individuals (gratuita).
# Gere em: https://console.redhat.com/insights/connector/activation-keys
RHSM_ORG_ID=0000000
RHSM_ACTIVATION_KEY=minha-activation-key

# Senha do usuário "student" criado em todas as VMs (uso apenas local/lab).
STUDENT_PASSWORD=troque-esta-senha

# true/false — roda "dnf -y update --security" no fim do kickstart.
# Desligado por padrão para builds mais rápidos e reprodutíveis.
APPLY_SECURITY_UPDATES=false
